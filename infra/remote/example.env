# Remote transport is NOT_IMPLEMENTED. These values document intended safe
# defaults only and are not consumed by Milestone 00.
QA_MCP_REMOTE_BIND_HOST=127.0.0.1
QA_MCP_REMOTE_PORT=8000
QA_MCP_REMOTE_TLS_REQUIRED=true
QA_MCP_REMOTE_AUTH_MODE=disabled_until_implemented

# Credential reference names only; never place credential values in this file.
QA_MCP_REMOTE_TLS_CERT_REF=QA_MCP_TLS_CERT_PATH
QA_MCP_REMOTE_TLS_KEY_REF=QA_MCP_TLS_KEY_PATH
