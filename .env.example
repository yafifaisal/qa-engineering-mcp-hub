# Milestone 00 local settings. These are non-secret values consumed by the
# implemented settings model.
QA_MCP_LOG_LEVEL=INFO
QA_MCP_SERVER_NAME=QA Engineering MCP Hub

# Future configuration support (NOT_IMPLEMENTED in Milestone 00).
# Use an absolute path appropriate to the local operating system when enabled.
# QA_MCP_CONFIG_FILE=/absolute/path/to/config.yaml
# QA_MCP_WORKSPACE_PATH=/absolute/path/to/qa-workspace

# Never put tokens, passwords, cookies, or private keys in this file.
# Future connection profiles refer to environment-variable names, for example
# QA_MCP_GITHUB_TOKEN, without storing their values in repository files.
