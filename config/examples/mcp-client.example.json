{
  "mcpServers": {
    "qa-engineering-hub": {
      "command": "/absolute/path/to/uv",
      "args": [
        "run",
        "--project",
        "/absolute/path/to/qa-engineering-mcp-hub",
        "qa-mcp",
        "serve"
      ],
      "env": {
        "QA_MCP_LOG_LEVEL": "INFO"
      }
    }
  }
}
