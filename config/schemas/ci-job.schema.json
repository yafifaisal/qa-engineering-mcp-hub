{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-mcp-hub.example/schemas/ci-job.schema.json",
  "title": "Registered CI job registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_status", "authorization", "jobs"],
  "properties": {
    "schema_version": {"const": 1},
    "implementation_status": {"enum": ["SCAFFOLDED", "IMPLEMENTED"]},
    "authorization": {"const": "read_only"},
    "jobs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "connection_id", "repository", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "provider": {
            "enum": ["bitbucket_pipelines", "github_actions", "jenkins"]
          },
          "connection_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "workflow": {"type": "string"},
          "ref": {"type": "string"},
          "enabled": {"type": "boolean"},
          "allow_trigger": {"type": "boolean"},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "allowed_values"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
                "allowed_values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}
                }
              }
            }
          }
        }
      }
    }
  }
}
