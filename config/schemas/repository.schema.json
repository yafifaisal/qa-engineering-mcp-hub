{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-mcp-hub.example/schemas/repository.schema.json",
  "title": "Repository registry fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories"],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "default_branch", "enabled"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "path": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
        "path_env": {
          "type": ["string", "null"],
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "connection_id": {
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "remote": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
        "include": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "exclude": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "indexing": {"enum": ["none", "metadata_only", "content"]},
        "default_branch": {"type": "string", "minLength": 1, "maxLength": 1024},
        "enabled": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["path"], "not": {"required": ["path_env"]}},
        {"required": ["path_env"], "not": {"required": ["path"]}},
        {
          "required": ["remote", "connection_id"],
          "allOf": [
            {"not": {"required": ["path"]}},
            {"not": {"required": ["path_env"]}}
          ]
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "repositories": {
      "type": "array",
      "items": {"$ref": "#/$defs/repository"}
    }
  }
}
