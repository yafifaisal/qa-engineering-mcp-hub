{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-mcp-hub.example/schemas/repository.schema.json",
  "title": "Repository registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_status", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "implementation_status": {"enum": ["SCAFFOLDED", "IMPLEMENTED"]},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "path_env", "default_branch", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "display_name": {"type": "string", "minLength": 1},
          "path_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "connection_id": {"type": "string", "minLength": 1},
          "default_branch": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
