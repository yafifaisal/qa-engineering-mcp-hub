{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-mcp-hub.example/schemas/evidence-policy.schema.json",
  "title": "Evidence collection policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "implementation_status",
    "required_checks", "missing_required_result", "redaction"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "implementation_status": {"enum": ["NOT_IMPLEMENTED", "SCAFFOLDED", "IMPLEMENTED"]},
    "required_checks": {
      "type": "array",
      "items": {"enum": ["api", "database", "kafka", "business", "security_redaction"]},
      "uniqueItems": true
    },
    "optional_checks": {
      "type": "array",
      "items": {"enum": ["api", "database", "kafka", "business", "security_redaction"]},
      "uniqueItems": true
    },
    "missing_required_result": {"enum": ["FAILED", "INCONCLUSIVE", "NOT_EXECUTED"]},
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "block_on_secret_detection"],
      "properties": {
        "profile": {"enum": ["standard", "strict"]},
        "block_on_secret_detection": {"type": "boolean"}
      }
    }
  }
}
