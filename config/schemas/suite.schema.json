{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-mcp-hub.example/schemas/suite.schema.json",
  "title": "Registered test suite registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_status", "suites"],
  "properties": {
    "schema_version": {"const": 1},
    "implementation_status": {"enum": ["SCAFFOLDED", "IMPLEMENTED"]},
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runner", "path", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "runner": {"enum": ["bruno", "postman"]},
          "path": {"type": "string", "minLength": 1},
          "environment": {"type": "string"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
