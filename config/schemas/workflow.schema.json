{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-mcp-hub.example/schemas/workflow.schema.json",
  "title": "QA workspace workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "implementation_status", "enabled",
    "evidence_policy", "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "implementation_status": {"enum": ["NOT_IMPLEMENTED", "SCAFFOLDED", "IMPLEMENTED"]},
    "enabled": {"type": "boolean"},
    "required_capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence_policy": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "target", "depends_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "kind": {"enum": ["api_suite", "database_assertion", "kafka_assertion", "business_assertion"]},
          "target": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
