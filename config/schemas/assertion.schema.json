{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-mcp-hub.example/schemas/assertion.schema.json",
  "title": "Registered deterministic assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "implementation_status", "enabled", "definition"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "kind": {"enum": ["api", "database", "sql", "kafka", "business"]},
    "implementation_status": {"enum": ["NOT_IMPLEMENTED", "SCAFFOLDED", "IMPLEMENTED"]},
    "enabled": {"type": "boolean"},
    "connection_id": {"type": "string"},
    "definition": {
      "type": "object",
      "description": "Typed assertion data interpreted by its registered assertion kind."
    }
  }
}
